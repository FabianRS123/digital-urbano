# Clave de OpenRouter — https://openrouter.ai/keys
# NO la subas al repositorio: backend/.env está ignorado por .gitignore
OPENROUTER_API_KEY="sk-or-v1-..."

# Modelo a usar. Debe soportar tool calling.
#   google/gemini-2.5-flash        rápido y económico (por defecto)
#   anthropic/claude-sonnet-4.5    mejor redacción del dictamen
# Verifica los identificadores vigentes en https://openrouter.ai/models
OPENROUTER_MODEL="google/gemini-2.5-flash"

# Motor del gemelo: la API de Express que calcula prioridad, series y simulaciones.
TWIN_API_URL="http://localhost:3000/api/v1"
